# Git, built from its pinned source with the gcc library's Bootlin C
# toolchain and the buildenv library's make, for the runner's tests, which
# make, commit to and read Git repositories as the runner does. It is
# Trail's build of Git (`trail/git.gcsl`), with zlib linked statically and
# without what the tests never reach: curl, expat, Perl, Python, Tcl/Tk,
# translations and Git's optional Rust, so it works with local
# repositories alone.
import fs
import unpack from archive
import toolchain
import Toolchain from toolchain
import BuildEnv from "github.com/gcslib/buildenv"
import configure_make from "github.com/gcslib/buildenv"

# Where the build has the C toolchain, zlib and Git's source, and installs
# Git.
let GIT_CC = "/opt/cc"

let GIT_ZLIB = "/opt/zlib"

let GIT_SRC = "/work/src"

let GIT_OUT = "/opt/git"

# Git's install: `bin/git` and the helpers in `libexec/git-core`, which
# expect to be at `/opt/git`.
def build git() {
    let src = unpack(fetch(
        "https://mirrors.edge.kernel.org/pub/software/scm/git/git-2.56.0.tar.xz",
        sha256 = "26c56c296b38c0695b26fa95f475f1d01704d2d38e73465ca30b0b2f5dc789d3",
    ))
    let zlib = unpack(fetch(
        "https://zlib.net/fossils/zlib-1.3.1.tar.gz",
        sha256 = "9a93b2b7dfdac77ceba5a558a580e74667dd6fede4585b91eefb60f03b72df23",
    ))
    let installed = configure_make(zlib.dir("zlib-1.3.1"), configure = ["--static"])
    = git_built(src.dir("git-2.56.0"), installed.file("lib/libz.a"), installed.dir("include"))
}

# Git built from `src` with the static zlib `libz` and its headers
# `include`, installed at `GIT_OUT`.
#[hermetic]
fn git_built(
    src: Dir,
    libz: File,
    include: Dir,
    c: toolchain.CToolchain = toolchain.get(Toolchain::C),
    env: BuildEnv = toolchain.get(Toolchain::BuildEnv),
) -> Dir {
    let compiler = "{GIT_CC}/{c.cc.path.strip_prefix(c.root.path).strip_prefix("/")}"
    let archiver = "{GIT_CC}/{c.ar.path.strip_prefix(c.root.path).strip_prefix("/")}"
    let placed: List<{at: String, place: Dir | File | FileSet}> = [
        {at = "/"; place = env.root},
        {at = "/"; place = c.runtime},
        {at = GIT_CC; place = c.root},
        {at = "{GIT_ZLIB}/lib/libz.a"; place = libz},
        {at = "{GIT_ZLIB}/include"; place = include},
        {at = "/work/src-in"; place = src},
    ]
    let box = fs.compose(placed).sandbox(cwd = "/work", env = {PATH = "/bin:/usr/bin"; HOME = "/tmp"; TMPDIR = "/tmp"})
    let ran = box.exec(
        "/bin/sh",
        "-c",
        "mkdir -p /tmp && cp -R /work/src-in {GIT_SRC} && chmod -R u+w {GIT_SRC} && cd {GIT_SRC} && \
         make -j4 prefix={GIT_OUT} CC=\"$1\" AR=\"$2\" ZLIB_PATH={GIT_ZLIB} \
             NO_CURL=1 NO_EXPAT=1 NO_PERL=1 NO_PYTHON=1 NO_TCLTK=1 NO_GETTEXT=1 NO_OPENSSL=1 \
             NO_ICONV=1 NO_RUST=1 NO_INSTALL_HARDLINKS=1 INSTALL_SYMLINKS=1 SKIP_DASHED_BUILT_INS=1 \
             install",
        "sh",
        compiler,
        archiver,
    )
    = box.dir(GIT_OUT)
}
